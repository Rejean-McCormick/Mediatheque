# Médiathèque kOA — example local environment
#
# Copy this file to .env for local overrides.
# Do not commit .env.
#
# Engine and instance data are separate. Bind one explicit sibling instance.

# ---------------------------------------------------------------------------
# App identity
# ---------------------------------------------------------------------------

KOA_APP_PUBLIC_NAME="Médiathèque kOA"
KOA_APP_SHORT_NAME="kOA"
KOA_APP_TECHNICAL_NAME="koa-mediatheque"
KOA_APP_COMPONENT="koa_mediatheque"
KOA_APP_PRIMARY_LANGUAGE="fr"

# ---------------------------------------------------------------------------
# Canonical local paths
# ---------------------------------------------------------------------------

KOA_ROOT="."
KOA_APP_ROOT="."
KOA_CONTENT_ROOT="../mediatheque-privee"
KOA_DB_PATH="../mediatheque-privee/01_DB/koa_mediatheque.sqlite"
KOA_STORAGE_ROOT="../mediatheque-privee/02_STORAGE"
KOA_IMPORTS_ROOT="../mediatheque-privee/03_IMPORTS"
KOA_EXPORTS_ROOT="../mediatheque-privee/04_EXPORTS"
KOA_BACKUPS_ROOT="../mediatheque-privee/07_BACKUPS"
KOA_LOGS_ROOT="../mediatheque-privee/08_LOGS"
KOA_GUI_ROOT="06_GUI/koa_mediatheque_gui"

# ---------------------------------------------------------------------------
# GUI
# ---------------------------------------------------------------------------

KOA_STREAMLIT_APP="06_GUI/koa_mediatheque_gui/app.py"
KOA_STREAMLIT_HOST="localhost"
KOA_STREAMLIT_PORT="8501"
KOA_STREAMLIT_HEADLESS="true"

# ---------------------------------------------------------------------------
# Default storage behavior
# ---------------------------------------------------------------------------

# Allowed values:
# reference_only
# copy_to_storage
# copy_and_rename
KOA_DEFAULT_COPY_MODE="copy_to_storage"

# Canonical storage filearea used for original files.
KOA_DEFAULT_FILEAREA="media_original"

# ---------------------------------------------------------------------------
# Validation defaults
# ---------------------------------------------------------------------------

# AI must not set canonical_validation_state=verified unless this is explicitly
# enabled for a human-controlled operation.
KOA_ALLOW_HUMAN_VERIFIED_OVERRIDE="false"

# Require review when rights/source/public state are unknown or restricted.
KOA_REQUIRE_HUMAN_REVIEW_FOR_UNKNOWN_RIGHTS="true"
KOA_REQUIRE_HUMAN_REVIEW_FOR_UNKNOWN_SOURCE="true"
KOA_BLOCK_PUBLIC_EXPORT_FOR_NON_PUBLIC="true"
KOA_BLOCK_UCKK_EXPORT_FOR_NOT_UCKK="true"

# ---------------------------------------------------------------------------
# XLSX
# ---------------------------------------------------------------------------

KOA_XLSX_EXPORT_DIR="../mediatheque-privee/04_EXPORTS/xlsx"
KOA_XLSX_DEFAULT_FILENAME_PREFIX="koa_library"
KOA_XLSX_CREATE_BACKUP_BEFORE_IMPORT="true"

# ---------------------------------------------------------------------------
# Manifest exports
# ---------------------------------------------------------------------------

KOA_MANIFEST_EXPORT_DIR="../mediatheque-privee/04_EXPORTS/manifests"
KOA_MANIFEST_FILENAME="manifest.json"
KOA_DEFAULT_EXPORT_ACTOR="local_user"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

KOA_LOG_LEVEL="INFO"
KOA_LOG_FILE="../mediatheque-privee/08_LOGS/koa_mediatheque.log"

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

KOA_DEV_MODE="true"
KOA_DEBUG_SQL="false"