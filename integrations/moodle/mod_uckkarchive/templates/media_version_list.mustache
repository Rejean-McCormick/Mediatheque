    @template mod_uckkarchive/media_version_list

    Media version list for UCKK Archive media objects.

    Context variables:
    {
        "mediaid": 12,
        "mediauuid": "2b85b5fd-73a6-4d78-a2d5-1a68d089f004",
        "title": "Interview recording",
        "hasversions": true,
        "canversionmedia": true,
        "caneditmedia": true,
        "candownloadmedia": true,
        "showfiles": true,
        "addversionurl": "https://example.test/mod/uckkarchive/media.php?id=7&action=addversion&mediaid=12",
        "versions": [
            {
                "id": 44,
                "uuid": "d4bb5e89-9daa-42b9-8c99-4ef3387e4ad4",
                "versionnumber": 2,
                "label": "Caption correction",
                "status": "active",
                "statuslabel": "Active",
                "filearea": "media_caption",
                "filearealabel": "Captions",
                "filename": "captions.vtt",
                "filesizeformatted": "24 KB",
                "mimetype": "text/vtt",
                "contenthash": "abc123",
                "iscurrent": true,
                "createdbyname": "Ada Lovelace",
                "modifiedbyname": "Ada Lovelace",
                "timecreatedformatted": "27 May 2026, 10:00",
                "timemodifiedformatted": "27 May 2026, 10:15",
                "summary": "Updated caption timing.",
                "hasfiles": true,
                "files": [
                    {
                        "filearea": "media_caption",
                        "filearealabel": "Captions",
                        "filename": "captions.vtt",
                        "filesizeformatted": "24 KB",
                        "mimetype": "text/vtt",
                        "url": "https://example.test/pluginfile.php/...",
                        "downloadurl": "https://example.test/pluginfile.php/..."
                    }
                ],
                "viewurl": "https://example.test/mod/uckkarchive/media.php?id=7&mediaid=12&versionid=44",
                "makecurrenturl": "https://example.test/mod/uckkarchive/media.php?id=7&action=makecurrent&versionid=44",
                "deleteurl": "https://example.test/mod/uckkarchive/media.php?id=7&action=deleteversion&versionid=44",
                "canmakecurrent": false,
                "candelete": true
            }
        ]
    }
}}

<div class="uckkarchive-media-version-list"
     data-region="media-version-list"
     data-media-id="{{mediaid}}"
     {{#mediauuid}}data-media-uuid="{{mediauuid}}"{{/mediauuid}}>

    <div class="uckkarchive-media-version-list__header d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div class="uckkarchive-media-version-list__heading">
            <h3 class="h5 mb-1">
                {{#str}} mediaversions, uckkarchive {{/str}}
            </h3>

            {{#title}}
                <div class="text-muted">
                    {{title}}
                </div>
            {{/title}}
        </div>

        {{#canversionmedia}}
            {{#addversionurl}}
                <div class="uckkarchive-media-version-list__actions">
                    <a class="btn btn-primary btn-sm"
                       href="{{addversionurl}}"
                       data-action="add-media-version"
                       data-media-id="{{mediaid}}">
                        {{#str}} addmediaversion, uckkarchive {{/str}}
                    </a>
                </div>
            {{/addversionurl}}
        {{/canversionmedia}}
    </div>

    {{#hasversions}}
        <ol class="uckkarchive-media-version-list__items list-unstyled mb-0">
            {{#versions}}
                <li class="uckkarchive-media-version-list__item card mb-3 {{#iscurrent}}border-primary{{/iscurrent}}"
                    data-region="media-version"
                    data-version-id="{{id}}"
                    {{#uuid}}data-version-uuid="{{uuid}}"{{/uuid}}>

                    <div class="card-header d-flex flex-wrap align-items-start justify-content-between gap-2">
                        <div class="uckkarchive-media-version-list__version-title">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong>
                                    {{#str}} version, uckkarchive {{/str}} {{versionnumber}}
                                </strong>

                                {{#label}}
                                    <span class="text-muted">
                                        — {{label}}
                                    </span>
                                {{/label}}

                                {{#iscurrent}}
                                    <span class="badge badge-primary">
                                        {{#str}} currentversion, uckkarchive {{/str}}
                                    </span>
                                {{/iscurrent}}

                                {{#statuslabel}}
                                    <span class="badge badge-secondary">
                                        {{statuslabel}}
                                    </span>
                                {{/statuslabel}}
                            </div>

                            <div class="small text-muted mt-1">
                                {{#timecreatedformatted}}
                                    <span>
                                        {{#str}} created, uckkarchive {{/str}}:
                                        {{timecreatedformatted}}
                                    </span>
                                {{/timecreatedformatted}}

                                {{#createdbyname}}
                                    <span>
                                        · {{#str}} by, uckkarchive {{/str}} {{createdbyname}}
                                    </span>
                                {{/createdbyname}}

                                {{#timemodifiedformatted}}
                                    <span>
                                        · {{#str}} modified, uckkarchive {{/str}}:
                                        {{timemodifiedformatted}}
                                    </span>
                                {{/timemodifiedformatted}}
                            </div>
                        </div>

                        <div class="uckkarchive-media-version-list__version-actions btn-group btn-group-sm" role="group">
                            {{#viewurl}}
                                <a class="btn btn-outline-secondary"
                                   href="{{viewurl}}"
                                   data-action="view-media-version"
                                   data-version-id="{{id}}">
                                    {{#str}} view {{/str}}
                                </a>
                            {{/viewurl}}

                            {{#canmakecurrent}}
                                {{#makecurrenturl}}
                                    <a class="btn btn-outline-primary"
                                       href="{{makecurrenturl}}"
                                       data-action="make-current-media-version"
                                       data-version-id="{{id}}">
                                        {{#str}} makecurrent, uckkarchive {{/str}}
                                    </a>
                                {{/makecurrenturl}}
                            {{/canmakecurrent}}

                            {{#candelete}}
                                {{#deleteurl}}
                                    <a class="btn btn-outline-danger"
                                       href="{{deleteurl}}"
                                       data-action="delete-media-version"
                                       data-version-id="{{id}}">
                                        {{#str}} delete {{/str}}
                                    </a>
                                {{/deleteurl}}
                            {{/candelete}}
                        </div>
                    </div>

                    <div class="card-body">
                        {{#summary}}
                            <div class="uckkarchive-media-version-list__summary mb-3">
                                {{{summary}}}
                            </div>
                        {{/summary}}

                        <dl class="uckkarchive-media-version-list__metadata row mb-0">
                            {{#filearealabel}}
                                <dt class="col-sm-3">
                                    {{#str}} filearea, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    {{filearealabel}}
                                </dd>
                            {{/filearealabel}}

                            {{#filename}}
                                <dt class="col-sm-3">
                                    {{#str}} filename, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    {{filename}}
                                </dd>
                            {{/filename}}

                            {{#filesizeformatted}}
                                <dt class="col-sm-3">
                                    {{#str}} filesize, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    {{filesizeformatted}}
                                </dd>
                            {{/filesizeformatted}}

                            {{#mimetype}}
                                <dt class="col-sm-3">
                                    {{#str}} mimetype, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    <code>{{mimetype}}</code>
                                </dd>
                            {{/mimetype}}

                            {{#contenthash}}
                                <dt class="col-sm-3">
                                    {{#str}} contenthash, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    <code class="small">{{contenthash}}</code>
                                </dd>
                            {{/contenthash}}

                            {{#modifiedbyname}}
                                <dt class="col-sm-3">
                                    {{#str}} modifiedby, uckkarchive {{/str}}
                                </dt>
                                <dd class="col-sm-9">
                                    {{modifiedbyname}}
                                </dd>
                            {{/modifiedbyname}}
                        </dl>

                        {{#showfiles}}
                            {{#hasfiles}}
                                <div class="uckkarchive-media-version-list__files mt-3">
                                    <h4 class="h6">
                                        {{#str}} files {{/str}}
                                    </h4>

                                    <ul class="list-group">
                                        {{#files}}
                                            <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                <div class="uckkarchive-media-version-list__file">
                                                    <div>
                                                        {{#url}}
                                                            <a href="{{url}}">
                                                                {{filename}}
                                                            </a>
                                                        {{/url}}

                                                        {{^url}}
                                                            <span>{{filename}}</span>
                                                        {{/url}}
                                                    </div>

                                                    <div class="small text-muted">
                                                        {{#filearealabel}}
                                                            <span>{{filearealabel}}</span>
                                                        {{/filearealabel}}

                                                        {{#filesizeformatted}}
                                                            <span> · {{filesizeformatted}}</span>
                                                        {{/filesizeformatted}}

                                                        {{#mimetype}}
                                                            <span> · <code>{{mimetype}}</code></span>
                                                        {{/mimetype}}
                                                    </div>
                                                </div>

                                                {{#downloadurl}}
                                                    <a class="btn btn-outline-secondary btn-sm"
                                                       href="{{downloadurl}}"
                                                       data-action="download-version-file">
                                                        {{#str}} download {{/str}}
                                                    </a>
                                                {{/downloadurl}}
                                            </li>
                                        {{/files}}
                                    </ul>
                                </div>
                            {{/hasfiles}}

                            {{^hasfiles}}
                                <div class="alert alert-light mt-3 mb-0">
                                    {{#str}} noversionfiles, uckkarchive {{/str}}
                                </div>
                            {{/hasfiles}}
                        {{/showfiles}}
                    </div>
                </li>
            {{/versions}}
        </ol>
    {{/hasversions}}

    {{^hasversions}}
        <div class="alert alert-info mb-0" data-region="empty-media-version-list">
            {{#str}} nomediaversions, uckkarchive {{/str}}

            {{#canversionmedia}}
                {{#addversionurl}}
                    <div class="mt-2">
                        <a class="btn btn-primary btn-sm"
                           href="{{addversionurl}}"
                           data-action="add-media-version"
                           data-media-id="{{mediaid}}">
                            {{#str}} addmediaversion, uckkarchive {{/str}}
                        </a>
                    </div>
                {{/addversionurl}}
            {{/canversionmedia}}
        </div>
    {{/hasversions}}
</div>